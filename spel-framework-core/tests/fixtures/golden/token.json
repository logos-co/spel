{
  "version": "2",
  "name": "token",
  "messages": [
    {
      "name": "NewDefinition",
      "tag": 0,
      "docs": "Create a fungible token.\n\nSent to the empty definition actor, which must be authorized. The initial supply\ngoes to `holding`, which must be empty and authorized too.",
      "fields": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "total_supply",
          "type": "u128"
        },
        {
          "name": "mint_authority",
          "type": {
            "option": "account_id"
          },
          "docs": "`Some(id)` makes the token mintable by `id`; `None` fixes the supply."
        },
        {
          "name": "holding",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "InitializeHolding",
      "tag": 1,
      "docs": "Create a zero holding of `definition`.\n\nSent to the empty, authorized holding actor, which asks the definition to\ninitialize it. A holding of the same definition makes this a no-op.",
      "fields": [
        {
          "name": "definition",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "Transfer",
      "tag": 2,
      "docs": "Move `amount` from the receiving holding (authorized) to the holding at `to`,\nwhich must already hold the same token.",
      "fields": [
        {
          "name": "to",
          "type": "account_id"
        },
        {
          "name": "amount",
          "type": "u128"
        }
      ]
    },
    {
      "name": "Burn",
      "tag": 3,
      "docs": "Destroy `amount` from the receiving holding (authorized).",
      "fields": [
        {
          "name": "amount",
          "type": "u128"
        }
      ]
    },
    {
      "name": "Mint",
      "tag": 4,
      "docs": "Mint `amount` of `definition` into the holding at `to`.\n\nSent to the definition when it is its own authority (and authorized), otherwise to\nthe authority's actor (authorized), which forwards it.",
      "fields": [
        {
          "name": "definition",
          "type": "account_id"
        },
        {
          "name": "to",
          "type": "account_id"
        },
        {
          "name": "amount",
          "type": "u128"
        }
      ]
    },
    {
      "name": "SetAuthority",
      "tag": 5,
      "docs": "Rotate (`Some`) or renounce (`None`) the mint authority. Routed like `Mint`.",
      "fields": [
        {
          "name": "definition",
          "type": "account_id"
        },
        {
          "name": "new_authority",
          "type": {
            "option": "account_id"
          }
        }
      ]
    },
    {
      "name": "ReadState",
      "tag": 6,
      "docs": "Reply to the sender with this actor's state, as a `lee_core::program::StateReply`."
    }
  ],
  "state": {
    "defined": "TokenState"
  },
