{
  "version": "2",
  "name": "nft",
  "messages": [
    {
      "name": "NewDefinition",
      "tag": 0,
      "docs": "Create an NFT with `printable_supply` units, all on the master.\n\nSent to the empty definition actor, which must be authorized. The master must be\nempty and authorized too.",
      "fields": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "printable_supply",
          "type": "u128"
        },
        {
          "name": "metadata",
          "type": {
            "defined": "NftMetadata"
          }
        },
        {
          "name": "master",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "InitializeHolding",
      "tag": 1,
      "docs": "Create a holding of `definition` that holds nothing; it can then receive a master or\na copy.\n\nSent to the empty, authorized holding actor, which asks the definition to\ninitialize it. A holding of the same definition makes this a no-op.",
      "fields": [
        {
          "name": "definition",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "Transfer",
      "tag": 2,
      "docs": "Move the receiving holding's whole value (authorized) to the holding at `to`, which\nmust be a holding of the same definition that holds nothing.",
      "fields": [
        {
          "name": "to",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "PrintNft",
      "tag": 3,
      "docs": "Print one copy from the receiving master (authorized) to the holding at `to`, which\nmust be a holding of the same definition that holds nothing.",
      "fields": [
        {
          "name": "to",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "Burn",
      "tag": 4,
      "docs": "Destroy `amount` from the receiving holding (authorized): up to the print balance of\na master, exactly 1 of an owned copy.",
      "fields": [
        {
          "name": "amount",
          "type": "u128"
        }
      ]
    },
    {
      "name": "ReadState",
      "tag": 5,
      "docs": "Reply to the sender with this actor's state, as a `lee_core::program::StateReply`."
    }
  ],
  "state": {
    "defined": "NftState"
  },
  "events": [
